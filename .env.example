# Copiez ce fichier en .env (jamais commité) puis adaptez les valeurs.

# --- Base de données (conteneur PostgreSQL local) ---
POSTGRES_DB=shopmaster
POSTGRES_USER=shopmaster
POSTGRES_PASSWORD=shopmaster-local
# Port exposé sur votre machine (changez-le si un PostgreSQL local occupe déjà 5432)
DB_PORT=5432

# --- Auth0 : voir docs/auth0.md ---
AUTH0_DOMAIN=votre-tenant.eu.auth0.com
AUTH0_CLIENT_ID=votre-client-id-spa
AUTH0_AUDIENCE=https://api.shopmaster.app

# --- URLs vues par le navigateur ---
API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
