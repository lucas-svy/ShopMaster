# Rendu en /etc/nginx/conf.d/default.conf au démarrage (envsubst remplace ${PORT}).
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Configuration générée au démarrage : jamais en cache.
    location = /config.js {
        expires -1;
    }

    # Fichiers produits par Vite (nom contenant un hash) : cache long.
    location /assets/ {
        expires 1y;
    }

    # Application monopage : toutes les routes (/connexion, /inscription...) servent index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
